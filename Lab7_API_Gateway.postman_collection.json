{
  "info": {
    "name": "Lab 7 - API Gateway, Service Discovery & Cloud",
    "description": "CampusConnect Lab 7 – All requests routed through the API Gateway (single entry point).\n\nCovers:\n• Gateway health check\n• Gateway-routed CRUD for Users, Products, Orders\n• 502/503 error handling for unreachable services",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "GATEWAY_URL",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Gateway Health Check",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{GATEWAY_URL}}/health",
              "host": ["{{GATEWAY_URL}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
