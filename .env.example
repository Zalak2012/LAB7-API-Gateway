# ── Gateway Configuration ────────────────────────────────────────────────────
GATEWAY_PORT=3000

# ── Service URLs (override service-registry.json) ────────────────────────────
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# ── MongoDB Atlas Connection Strings ─────────────────────────────────────────
# Replace with your actual MongoDB Atlas connection strings
MONGO_URI_USERS=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/user_db?retryWrites=true&w=majority
MONGO_URI_PRODUCTS=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/product_db?retryWrites=true&w=majority
MONGO_URI_ORDERS=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/order_db?retryWrites=true&w=majority
